# ============================================================
# AGENTIC BI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Groq API Key - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (llama3 recommended for speed + quality)
GROQ_MODEL=llama3-70b-8192

# DuckDB file path (relative to project root)
DUCKDB_PATH=data/agentic_bi.duckdb

# Max SQL retry attempts on error
MAX_SQL_RETRIES=3

# App display language (vi / en)
APP_LANG=vi
