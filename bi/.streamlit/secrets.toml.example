# Copy this to .streamlit/secrets.toml (local) or paste into Streamlit Cloud Secrets UI

# Anthropic Claude API (required)
ANTHROPIC_API_KEY = "sk-ant-..."

# Cloudflare R2 credentials
S3_ENDPOINT  = "https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY = ""
S3_SECRET_KEY = ""
S3_REGION    = "auto"

# Iceberg REST catalog — use the cf-iceberg tunnel URL
# Get from: cat tunnel-urls.txt | grep iceberg
ICEBERG_REST_URI = "https://<tunnel-id>.trycloudflare.com"

# Optional: override Claude model
# CLAUDE_MODEL = "claude-sonnet-4-6"
