# ============================================================
# Olist Data Lakehouse – Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored — never commit credentials.
# See SETUP.md for detailed instructions on obtaining each value.
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_PASSWORD=olistpass

# ─── Cloudflare R2 ──────────────────────────────────────────
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# From R2 API Token (Cloudflare dashboard → R2 → Manage R2 API Tokens)
S3_ACCESS_KEY=your_r2_access_key_here
S3_SECRET_KEY=your_r2_secret_key_here

S3_REGION=auto
S3_PATH_STYLE=false

# ─── Spark Resources ────────────────────────────────────────
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# ─── Service URLs (Codespaces / Remote) ─────────────────────
# Khi chạy local: để trống, các giá trị mặc định tự dùng localhost.
# Khi chạy trên GitHub Codespaces: bỏ comment và điền CODESPACE_NAME.
#
# CODESPACE_NAME tự động có trong terminal Codespaces:
#   echo $CODESPACE_NAME
#
# Sau đó bỏ comment và thay <CODESPACE_NAME> bằng tên thật:

# Prefect UI (browser → API):
# PREFECT_UI_API_URL=https://<CODESPACE_NAME>-4200.app.github.dev/api

# Iceberg REST catalog (Python scripts bên ngoài Docker):
# ICEBERG_REST_URI=http://localhost:8181

# MLflow tracking (ML scripts, Streamlit):
# MLFLOW_TRACKING_URI=http://localhost:5000

# Redpanda Kafka brokers (streaming producer/consumer bên ngoài Docker):
# REDPANDA_BROKERS=localhost:19092

# ─── Agentic BI ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
